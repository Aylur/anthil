{
  "name": "@anthil/router",
  "version": "1.0.1",
  "description": "Tiny type-safe client-side router.",
  "keywords": [
    "router",
    "routing",
    "react",
    "typescript",
    "spa"
  ],
  "license": "MIT",
  "author": "Kristóf Demeter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aylur/anthil.git",
    "directory": "packages/router"
  },
  "homepage": "https://github.com/Aylur/anthil/tree/main/packages/router#readme",
  "bugs": {
    "url": "https://github.com/Aylur/anthil/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.tsx"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react/index.d.ts",
        "import": "./dist/react/index.js"
      }
    }
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
